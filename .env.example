# ========== DESENVOLVIMENTO LOCAL ==========
# Descomente para usar SQLite localmente
# NODE_ENV=development
# DATABASE_CLIENT=sqlite
# DATABASE_URL=./db/app.db
# PORT=3333

# ========== TESTES ==========
# Descomente para rodar testes
# NODE_ENV=test
# DATABASE_CLIENT=sqlite
# DATABASE_URL=:memory:
# PORT=3333

# ========== PRODUÇÃO (RENDER/HEROKU/ETC) ==========
# Sempre use PostgreSQL em produção!
# NODE_ENV=production
# DATABASE_CLIENT=pg
# DATABASE_URL=postgres://usuario:senha@host:5432/database
# PORT=3000

# ========== CONFIGURAÇÃO PADRÃO ==========
NODE_ENV=development
DATABASE_CLIENT=sqlite
DATABASE_URL=./db/app.db
PORT=3333
